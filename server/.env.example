# ScamShield AI - Backend Environment Variables
PORT=5001

# AWS Region where your Bedrock model access is enabled (typically us-east-1 or us-west-2)
AWS_REGION=us-east-1

# Amazon S3 Threat Intelligence Vault (stores past scam campaigns so agent adapts)
# S3_BUCKET_NAME=scamshield-threat-vault-your-account-id

# Bedrock Model ID (defaults to us.amazon.nova-lite-v1:0)
# Other popular options:
# BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0
# BEDROCK_MODEL_ID=us.amazon.nova-micro-v1:0
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# -------------------------------------------------------------
# OPTION A: Standard AWS IAM Access Keys (Most Common)
# -------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only required if using AWS Academy / Learner Lab / temporary session credentials:
# AWS_SESSION_TOKEN=

# -------------------------------------------------------------
# OPTION B: Hackathon / Workshop Bedrock Bearer Token or API Key
# -------------------------------------------------------------
# AWS_BEARER_TOKEN_BEDROCK=
