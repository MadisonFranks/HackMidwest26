# ScamShield AI - Backend Environment Variables
PORT=5001

# AWS Region where your Bedrock model access is enabled (typically us-east-1 or us-west-2)
AWS_REGION=us-east-1

# Optional: Pin a specific Bedrock Model ID (defaults to us.anthropic.claude-3-5-sonnet-20241022-v2:0)
# Other popular options:
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
# BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0

# Standard AWS IAM Access Keys (Most Common)

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY= 

