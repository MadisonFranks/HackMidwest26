# ScamShield AI - Backend Environment Variables
PORT=5001

# AWS Region (Bedrock models are typically in us-east-1 or us-west-2)
AWS_REGION=us-east-1

# AWS Credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: only if using AWS Academy / temporary session credentials
AWS_SESSION_TOKEN=

# Or if Hack Midwest provided an AWS Bedrock Bearer Token:
# AWS_BEARER_TOKEN_BEDROCK=
