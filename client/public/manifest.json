{
  "manifest_version": 3,
  "name": "ScamShield AI",
  "version": "1.0.0",
  "description": "An AI-powered browser extension that helps identify suspicious messages and scams.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Open ScamShield AI"
  },
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost:5001/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}